{
  "name": "sinzo-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade e-commerce platform (storefront + admin) - BDT / COD / Steadfast / Meta CAPI ready",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate --schema prisma/schema.prod.prisma && next build && node scripts/ensure-db.js",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "wa": "node scripts/whatsapp-bridge.js",
    "wa:worker": "node scripts/wa-worker.js",
    "recovery:run": "node scripts/abandoned-worker.js --once",
    "recovery:worker": "node scripts/abandoned-worker.js",
    "postinstall": "prisma generate",
    "test": "node scripts/smoke.js",
    "test:touch": "node scripts/touch-audit.mjs",
    "db:push:prod": "prisma db push --schema prisma/schema.prod.prisma",
    "db:seed:prod": "prisma generate --schema prisma/schema.prod.prisma && node prisma/seed.js",
    "admin:passwd": "node scripts/set-admin-password.js",
    "db:verify": "node scripts/verify-db-migration.js",
    "schema:sync": "node scripts/sync-prod-schema.js",
    "backup": "node scripts/backup.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.cjs",
    "test:api": "node tests/api-regressions.mjs",
    "test:recovery": "node tests/recovery-api.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run test:touch"
  },
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@prisma/engines": "^5.22.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "2.4.3",
    "next": "15.5.27",
    "nodemailer": "10.0.13",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "typescript": "5.6.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
