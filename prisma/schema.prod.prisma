// PRODUCTION schema (PostgreSQL) — used by Vercel builds + prod db push.
// Local dev keeps using prisma/schema.prisma (SQLite).
// GENERATED by scripts/sync-prod-schema.js — edit prisma/schema.prisma instead, then run
//   npm run schema:sync
// Usage:
//   npx prisma db push --schema prisma/schema.prod.prisma
//   npx prisma generate --schema prisma/schema.prod.prisma
// Requires DATABASE_URL (PostgreSQL connection string) in the environment.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // SUPER_ADMIN | ADMIN | ORDER_MANAGER | PRODUCT_MANAGER | MARKETING | SUPPORT
  active    Boolean  @default(true)
  // 2FA (TOTP — works with Google Authenticator / Authy / 1Password). The secret is stored
  // only once the first valid code is entered, so a half-finished setup can never lock anyone out.
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  // bumping this invalidates every token issued before it — "log out everywhere"
  sessionVersion   Int      @default(0)
  recoveryCodes    String?  // one-time 2FA recovery codes, sha256-hashed, newline separated
  // Password reset token (single-use, short-lived, hashed)
  resetToken       String?  // sha256-hex of the token sent via email
  resetTokenExpires DateTime?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String // JSON string
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  sizeChart   String?   // HTML table for size guide
  image       String?
  products    Product[]
  promotionEligible  PromotionEligibleCategory[]
  promotionExcluded  PromotionExcludedCategory[]
}

model Collection {
  id        Int                 @id @default(autoincrement())
  title     String
  slug      String              @unique
  subtitle  String?
  image     String?
  products  CollectionProduct[]
  createdAt DateTime            @default(now())
}

model CollectionProduct {
  collectionId Int
  productId    Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([collectionId, productId])
}

model Product {
  id          Int                @id @default(autoincrement())
  title       String
  slug        String             @unique
  shortDesc   String?
  description String?
  sku         String?
  barcode     String?
  price       Float
  comparePrice Float?
  cost        Float?
  stock       Int                @default(0)
  lowStock    Int                @default(5)
  status      String             @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  featured    Boolean            @default(false)
  tags        String?
  images      ProductImage[]
  variants    ProductVariant[]
  category    Category?          @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  collections CollectionProduct[]
  reviews     Review[]
  orderItems  OrderItem[]
  movements   InventoryMovement[]
  views       Int                @default(0)
  position    Int                @default(0) // admin drag&drop order -> homepage/listing
  sizeChartImage String?         // per-product size chart image (media URL)
  soldCount      Int?            // optional override: show "Sold: N" on the PDP when set
  saleEnds       DateTime?       // flash sale countdown: when set + comparePrice > price → countdown shows
  // ── kept in sync with schema.prod.prisma: these were missing here, so `npm run dev`
  //    (SQLite) crashed every page that selects preorder/preorderDate/soldMode ──
  preorder       Boolean          @default(false) // pre-order: order accepted before stock is available
  preorderDate   DateTime?                        // expected delivery date shown to customers
  soldMode       String           @default("fixed") // "fixed" = exact admin number | "random" = auto base that slowly grows
  badge          String?
  isNew          Boolean          @default(false) // -> New Arrivals collection + badge
  isBestSeller   Boolean          @default(false) // -> Best Sellers collection + badge
  colorGroupId Int?              // linked color family (null = standalone product)
  colorName    String?           // this product's color label (e.g. Black) for the selector
  colorImage   String?           // circular swatch thumbnail in the color selector
  colorGroup   ColorGroup?       @relation(fields: [colorGroupId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([colorGroupId])
  waitlist        Waitlist[]
  promotionGiftEntries   PromotionGiftProduct[]
  promotionEligible      PromotionEligibleProduct[]
  promotionExcluded      PromotionExcludedProduct[]
  promotionExcludedGift  PromotionExcludedGiftProduct[]
}

model ColorGroup {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String   // order.placed | order.confirmed | order.cancelled | order.shipped | order.delivered | test
  title     String
  body      String
  ref       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  position  Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Out-of-stock waitlist: a customer asks to be told when this comes back, and the restock
// screen (or the cron endpoint) tells them — once, which is what notifiedAt guards.
model Waitlist {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  Int?
  contact    String
  note       String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  size      String?
  color     String?
  sku       String?
  price     Float?
  stock     Int     @default(0)
  barcode   String?
  productId Int
  image     String? // linked color image — selecting this color shows this image first in the gallery
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id        Int     @id @default(autoincrement())
  phone     String  @unique
  name      String?
  email     String?
  address   String?
  area      String?
  note      String?
  tags      String?
  password  String? // set = registered account (phone = login id)
  // loyalty: points are earned on delivered orders and spent as a discount code;
  // referralCode is this customer's own invite code (a friend entering it rewards both)
  points              Int      @default(0)
  referralCode        String?  @unique
  referredBy          Int?
  referralRewardedAt  DateTime?
  // WhatsApp marketing consent (transactional order updates do not need it)
  waOptIn             Boolean   @default(false)
  waOptInAt           DateTime?
  orders    Order[]
  createdAt DateTime @default(now())
}


model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  phone     String? // linked customer phone (order updates)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())
  code          String      @unique // ORD-1001 style, set in code
  name          String
  phone         String
  email         String?
  address       String
  area          String      // INSIDE_DHAKA | OUTSIDE_DHAKA
  notes         String?
  subtotal      Float
  discount      Float       @default(0)
  deliveryFee   Float       @default(0)
  total         Float
  couponCode    String?
  paymentMethod String      @default("COD")
  paymentStatus String      @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  status        String      @default("PENDING") // PENDING | CONFIRMED | PROCESSING | PACKED | SHIPPED | DELIVERED | CANCELLED | RETURNED | ON_HOLD
  riskLevel     String      @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  riskFlags     String?
  source        String?     // Facebook | Instagram | Google | Direct | Organic | Referral | Unknown
  channel       String      @default("vps") // deployment that received the order: vps | vercel (order isolation per website)
  attribution   String?     // JSON: utm*, fbclid, fbp, fbc
  ip            String?
  adminNote     String?
  courierName     String?
  courierConsignmentId String?
  courierStatus      String?
  courierTracking    String?
  customerId   Int?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  stockDeducted Boolean  @default(false) // inventory currently deducted; reset atomically on return/cancel
  // pack & scan (barcode/SKU station), and the post-delivery review-request nudge
  packedAt          DateTime?
  packedBy          String?
  reviewRequestedAt DateTime?
  payments          Payment[]
  promotionUsages  PromotionUsage[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])
  variantId Int? // kept for exact variant restock on cancel/return
  title     String
  variant   String?
  image     String?
  price     Float
  qty       Int
  stockDeductedQty Int? // exact quantity deducted at delivery; null = legacy order line

  preorder      Boolean   @default(false) // order line was placed as pre-order
  preorderDate  DateTime?               // expected delivery date captured at order time
  /// Free-gift lines: price is forced to 0 by the server, never by the browser.
  isGift           Boolean @default(false)
  giftPromotionId  String?
  giftTierIndex    Int?
  giftSlotKey      String?
}

model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  type           String   // percent | fixed | freeship
  value          Float    @default(0)
  minOrder       Float?
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int      @default(0)
  perCustomer    Int?
  firstOrderOnly Boolean  @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  rating    Int
  text      String
  photos    String? // JSON array of review photo URLs (max 3)
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  verified  Boolean  @default(false)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TrackingEvent {
  id        Int      @id @default(autoincrement())
  name      String
  eventId   String?
  source    String?  // browser | server | capi
  payload   String?
  ok        Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())
}

model AbandonedCheckout {
  id                Int      @id @default(autoincrement())
  phone             String?
  name              String?
  email             String?
  address           String?
  cartJson          String
  total             Float
  recovered         Boolean  @default(false)
  checkoutStatus    String   @default("OPEN") // OPEN | RECOVERED | CONVERTED
  recoveryEmailedAt DateTime?
  captureKeyHash    String?  @unique // browser-owned draft; never deduplicate/overwrite by phone alone
  captureRevision  Int      @default(0) // ignore late/out-of-order draft writes
  recoveryAttemptedAt DateTime? // durable at-most-once automatic SMTP attempt
  recoveryClaimId   String?
  recoveryError     String?
  convertedOrderId Int? // assigned atomically; enables idempotent conversion/replay

  @@index([checkoutStatus, recoveryAttemptedAt, updatedAt])
  updatedAt         DateTime @default(now())
  createdAt         DateTime @default(now())
}

model Subscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  // one-click unsubscribe from a campaign email (HMAC-signed link, see lib/campaign.ts).
  // Kept on the row rather than deleting it, so re-subscribing is a flag flip and the
  // export still shows who left.
  unsubscribed   Boolean   @default(false)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// One newsletter send. The body is plain text with the same paragraph rules as a blog post;
// {{name}} and {{unsubscribe}} are filled per recipient at send time. Progress columns let a
// long list be sent in batches across several requests instead of one long-running one.
model Campaign {
  id        Int       @id @default(autoincrement())
  subject   String
  body      String
  ctaLabel  String?
  ctaUrl    String?
  status    String    @default("DRAFT") // DRAFT | SENDING | SENT
  total     Int       @default(0)
  sent      Int       @default(0)
  failed    Int       @default(0)
  // last Subscriber id this campaign has processed — lets a big list go out in batches
  // across several requests, and survive the list changing mid-send
  cursorId  Int       @default(0)
  sentAt    DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userEmail String
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String   // ORDER | RESTOCK | MANUAL | RETURN | CANCEL
  ref       String?
  createdAt DateTime @default(now())
}

model Blacklist {
  id        Int      @id @default(autoincrement())
  type      String // PHONE | ADDRESS | IP
  value     String
  note      String?
  createdAt DateTime @default(now())
}

// Every taka that did not come from the courier's COD collection: an advance sent by bKash
// before shipping, or a settlement recorded by hand. The order's paid total is the sum of
// these rows (never a column that can drift), and Profit/courier reports read the same source.
model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("bkash")   // bkash | nagad | rocket | bank | cash | other
  kind      String   @default("ADVANCE") // ADVANCE | DUE | REFUND
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

// WhatsApp two-way: the bridge forwards every inbound message here, and the admin reply is
// stored next to it, so one thread per number.
model InboxMessage {
  id        Int      @id @default(autoincrement())
  waId      String
  name      String?
  direction String   // IN | OUT
  body      String
  orderId   Int?
  status    String   @default("ok") // ok | failed (with the reason in body)
  createdAt DateTime @default(now())
}

// One place for the things that fail in the background: client crashes, webhook calls, SMS
// gateway replies, WhatsApp bridge sends, backup runs. The Logs screen reads this.
model AppLog {
  id        Int      @id @default(autoincrement())
  level     String   @default("INFO") // INFO | WARN | ERROR
  kind      String   // CLIENT | WEBHOOK | SMS | WHATSAPP | MAIL | CRON | BACKUP
  message   String
  meta      String?
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  data      Bytes
  width     Int?
  height    Int?
  blurData  Bytes?
  variantsJson String?
  createdAt DateTime @default(now())
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  image     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// WhatsApp broadcast & automation (Baileys multi-device).
// Phase 1: devices + outbox queue + worker + auto order messages.
// Nothing here is sent inside a web request — every message is a WaMessage row
// that scripts/wa-worker.js picks up, paces and hands to the bridge.
// ─────────────────────────────────────────────────────────────────────────────
model WaDevice {
  id           Int       @id @default(autoincrement())
  name         String
  sessionId    String    @unique // .wa-auth/<sessionId>/ — the keys never leave that folder
  phone        String?
  status       String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | QR | PAUSED | BANNED
  isDefault    Boolean   @default(false)
  dailyCap     Int       @default(50) // warm-up: 50 → 150 → 300 → 400
  sentToday    Int       @default(0)
  sentDate     String? // YYYY-MM-DD, the day sentToday belongs to (counter reset)
  warmupStage  Int       @default(0) // 0 new · 1 2nd week · 2 3rd week · 3 mature
  consecutiveFailures Int @default(0) // auto-pause when a number keeps failing
  lastSeenAt   DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
}

model WaTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique // order_placed | order_confirmed | … | custom
  name      String
  category  String   @default("UTILITY") // UTILITY | MARKETING
  body      String // {name} {code} {amount} {tracking} {link} {coupon} {product} {items} {area} {eta}
  mediaMode String   @default("NONE") // NONE | PRODUCT | CUSTOM
  enabled   Boolean  @default(true) // per-event switch for the automatic events
  updatedAt DateTime @updatedAt
}

model WaMessage {
  id            Int       @id @default(autoincrement())
  deviceId      Int?
  toWaId        String // 8801XXXXXXXXX (digits only, country code)
  kind          String    @default("AUTO") // AUTO | BROADCAST | REPLY | MANUAL
  templateKey   String?
  body          String
  mediaJson     String? // JSON: image URLs, one per line in the message
  couponCode    String?
  orderId       Int?
  broadcastId   Int?
  status        String    @default("QUEUED") // QUEUED | SENDING | SENT | DELIVERED | READ | FAILED | SKIPPED
  attempts      Int       @default(0)
  error         String?
  dedupeKey     String?   @unique // "order_placed:1042" — an order never gets the same message twice
  bridgeId      String? // WhatsApp message id — delivery/read receipts match on this
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  meta          String? // JSON: code / name / amount / area — what the queue screen shows
  queuedAt      DateTime  @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  @@index([status, nextAttemptAt])
  @@index([dedupeKey])
  @@index([toWaId])
}

// ── WhatsApp broadcast (Phase 3): campaigns, short links, opt-outs ──

model WaBroadcast {
  id           Int       @id @default(autoincrement())
  name         String
  body         String
  templateKey  String?
  images       String? // JSON: image URLs
  productIds   String? // JSON: product ids — their cards are appended to the body
  couponCode   String?
  linkTarget   String? // URL the short link points at (empty = current store URL)
  linkSlug     String? // WaLink slug created for this campaign (click tracking)
  audienceRule String    @default("{}") // JSON: WaAudienceRule
  deviceIds    String? // JSON: [deviceId]; empty = least-loaded device
  status       String    @default("DRAFT") // DRAFT | SCHEDULED | RUNNING | PAUSED | DONE | FAILED
  scheduledAt  DateTime?
  recipients   String? // JSON: [{to,name}] frozen when the campaign starts
  total        Int       @default(0)
  sent         Int       @default(0)
  failed       Int       @default(0)
  skipped      Int       @default(0)
  enqueued     Int       @default(0)
  createdBy    String?
  lastError    String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  @@index([status, scheduledAt])
}

model WaLink {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  target      String
  label       String?
  broadcastId Int?
  clicks      Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())
}

model WaOptOut {
  id        Int      @id @default(autoincrement())
  waId      String   @unique // 8801XXXXXXXXX
  reason    String?
  source    String? // INBOUND | MANUAL | CSV
  createdAt DateTime @default(now())
}

// ============================================================
// PROMOTIONS — free-gift tier engine ("Choose More. Get More.")
// Ported from the trendings-commerce engine. The engine itself
// (lib/promotions/engine.ts) is pure and framework-free; these
// tables are only the admin-authored configuration it reads.
// Money is stored as integer MINOR units (poisha) everywhere.
// ============================================================
model Promotion {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  type        String    @default("GIFT_TIERS") // GIFT_TIERS | PERCENTAGE | FIXED | BUY_X_GET_Y
  status      String    @default("DRAFT")      // DRAFT | ACTIVE | PAUSED | ENDED
  priority    Int       @default(0)            // lower wins when several are live
  startsAt    DateTime  @default(now())
  endsAt      DateTime?

  countMode        String @default("QUANTITY")     // QUANTITY | DISTINCT_LINES
  eligibilityScope String @default("ALL_PRODUCTS") // ALL_PRODUCTS | PRODUCTS | CATEGORIES

  highestTierWins      Boolean @default(true)
  lockGrantedGifts     Boolean @default(false)
  lockBehavior         String  @default("KEEP_ALL") // KEEP_ALL | HIGHEST_ONLY
  requireGiftSelection Boolean @default(true)
  allowGiftSkipping    Boolean @default(false)
  maxGiftsPerOrder     Int?

  maxOrders  Int?
  usedOrders Int    @default(0)

  config String @default("{}") // JSON params for PERCENTAGE / FIXED / BUY_X_GET_Y

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers              PromotionTier[]
  giftPools          PromotionGiftPool[]
  eligibleProducts   PromotionEligibleProduct[]
  excludedProducts   PromotionExcludedProduct[]
  eligibleCategories PromotionEligibleCategory[]
  excludedCategories PromotionExcludedCategory[]
  excludedGiftItems  PromotionExcludedGiftProduct[]
  usages             PromotionUsage[]

  @@index([status, startsAt])
}

model PromotionTier {
  id               String  @id @default(cuid())
  promotionId      String
  index            Int
  key              String
  label            String
  description      String?
  requiredQuantity Int
  sortOrder        Int     @default(0)

  promotion Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  slots     PromotionTierSlot[]

  @@unique([promotionId, index])
  @@unique([promotionId, key])
}

model PromotionTierSlot {
  id         String @id @default(cuid())
  tierId     String
  giftPoolId String
  key        String  // stable slot key: "shirt", "denim-pant", "denim-jeans"
  label      String
  giftType   String  @default("CUSTOM")
  quantity   Int     @default(1)
  sortOrder  Int     @default(0)

  tier     PromotionTier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  giftPool PromotionGiftPool @relation(fields: [giftPoolId], references: [id], onDelete: Restrict)

  @@unique([tierId, key])
}

model PromotionGiftPool {
  id          String  @id @default(cuid())
  promotionId String
  key         String
  label       String
  description String?
  sortOrder   Int     @default(0)
  // Optional auto-fill: every ACTIVE product of these categories joins the
  // candidate list on top of the hand-picked rows below.
  autoFill    Boolean @default(false)
  categoryIds String  @default("[]") // JSON number[] of Category.id
  // Per-rule exclusion (owner request): ei pool theke ei product gulo kokhono free gift
  // hisebe offer hobe na — hand-picked hok ba category auto-fill, dutoi theke filter hoy.
  // Promotion-level "never give these as gifts" (PromotionExcludedGiftProduct) global thake;
  // eta tar upor ekta pool-scoped level. JSON number[] of Product.id
  excludeProductIds String @default("[]")

  promotion Promotion              @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  products  PromotionGiftProduct[]
  slots     PromotionTierSlot[]

  @@unique([promotionId, key])
}

model PromotionGiftProduct {
  id         String   @id @default(cuid())
  poolId     String
  productId  Int      // Product.id is Int (autoincrement) in this repo
  variantIds String   @default("[]") // JSON string[]; empty = every active variant
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  pool    PromotionGiftPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([poolId, productId])
}

model PromotionEligibleProduct {
  id          String @id @default(cuid())
  promotionId String
  productId   Int
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([promotionId, productId])
}

